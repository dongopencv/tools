{
  "name": "dsh-auto-handoff",
  "displayName": "长会话自动交接",
  "description": "会话达到 token 或工具调用阈值时，自动写交接文档并开新会话续作，避免单个长会话把上下文和额度吃光。",
  "version": "1.1.4",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "handoff",
    "compaction",
    "token"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "icon": "icons/icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "icons",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
