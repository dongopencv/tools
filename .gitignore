# 大件与运行时产物：不进仓库
work/
out/
elevate/

# 工具与代理留下的状态
# .workbuddy/ 整个目录不提交：agent 的每日记忆里天然会出现明文口令/PIN/token，
# 只忽略 tmp/ 不足以挡住 memory/。这类文件只该留在本机。
.agent-teams/
.workbuddy/
*.db
*.log
logs/

# 凭据一律不进仓库
.env
.env.*
!.env.example
*.token
.github-token
github.env
id_*_ed25519*
*.pem
*.pfx

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store
node_modules/
__pycache__/
*.pyc
