# 大件与运行时产物：不进仓库
work/
out/
elevate/

# 工具与运行会话留下的状态
# .workbuddy/ 整个目录不提交：agent 的每日记忆属于本机状态，只忽略 tmp/ 不足以挡住 memory/。
.local/
.agent-teams/
.workbuddy/
.dsh/
*.db
*.log
logs/

# 本机配置文件不进仓库
.env
.env.*
!.env.example
*.token
.github-token
github.env
id_*_ed25519*
*.pem
*.pfx

# 本机临时脚本与探针产物：不进仓库（.bench-* 测速、.status/.api/.push 是会话里的临时 helper）
.bench-*
.api.sh
.status.sh
.push.sh
.raw.sh
.nodedl.sh
.helpers.sh
nul
*.bak

# 会话临时探针/草稿（根目录隐藏文件）

# 会话临时探针/草稿（根目录隐藏文件）
/.c5.md
/.c5got.md
/.i5.md
/.probe.cjs
/.probe2.cjs

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store
node_modules/
__pycache__/
*.pyc
